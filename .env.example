DJANGO_SECRET_KEY=change-me-for-production
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

POSTGRES_DB=ml_resource_hub
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432

# Docker Compose: web uses POSTGRES_HOST=db; db + web must use the SAME password.
# If you change POSTGRES_PASSWORD after the first "docker compose up", reset the DB volume:
#   docker compose down -v && docker compose up --build
